rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserProfile() {
      return isSignedIn() && exists(userDocPath(request.auth.uid));
    }

    function userRole() {
      return hasUserProfile() ? get(userDocPath(request.auth.uid)).data.role : null;
    }

    function isAdmin() {
      return userRole() == 'tattooer';
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isChatParticipant(chatId) {
      return isSignedIn()
        && chatExists(chatId)
        && (request.auth.uid in getChat(chatId).data.participants);
    }

    function getChat(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId));
    }

    function chatExists(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId));
    }

    function canReadChat(chatId) {
      return isAdmin()
        || (chatExists(chatId) && isChatParticipant(chatId))
        || (!chatExists(chatId) && isSignedIn());
    }

    match /users/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create: if isSelf(uid);
      allow update: if isAdmin() || isSelf(uid);
      allow delete: if isAdmin();
    }

    match /portfolio/{uid} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /{document=**} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    match /availability/{uid} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /{document=**} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /booking-events/{eventId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if canReadChat(chatId);
      allow create: if isAdmin()
        || (isSignedIn()
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.keys().hasOnly(['participants', 'lastMessageAt', 'lastMessagePreview', 'createdAt']));
      allow update: if isAdmin()
        || (isSignedIn()
          && request.auth.uid in resource.data.participants
          && request.resource.data.participants == resource.data.participants
          && request.resource.data.keys().hasOnly(['participants', 'lastMessageAt', 'lastMessagePreview', 'createdAt']));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || isChatParticipant(chatId);
        allow create: if isAdmin()
          || (isSignedIn()
            && isChatParticipant(chatId)
            && request.auth.uid == request.resource.data.fromUid
            && request.resource.data.keys().hasOnly(['fromUid', 'text', 'imageUrl', 'createdAt', 'slotId', 'durationMin', 'timezone', 'type']));
        allow update, delete: if isAdmin();
      }
    }
  }
}
